# Mode-specific env for `bun start:dev` (NODE_ENV=development).
# Copy to .env.development:  cp .env.development.example .env.development
# Loaded after .env and overrides overlapping keys (see src/config/index.ts).
#
# Local DATABASE_URL is built from PROJECT_SLUG, POSTGRES_* in .env.
# Set DATABASE_URL here only if you are not using Docker Compose.

NODE_ENV=development

SUPER_ADMIN_PASSWORD=123456
BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

BASE_URL_CLIENT="http://localhost:3161"
BASE_URL_SERVER="http://localhost:5161"

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
