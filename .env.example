# =============================================================================
# Env layout (loaded by src/config/index.ts)
# =============================================================================
# .env                 → common vars (always loaded) — copy from this file
# .env.development     → used by `bun start:dev`  — copy from .env.development.example
# .env.production      → used by `bun start:prod` — copy from .env.production.example
#
# Docker Compose auto-loads .env (PROJECT_SLUG, ports, Postgres/pgAdmin credentials).
# Mode files override any overlapping keys from .env.
# =============================================================================

# --- Common (.env) ---
PROJECT_NAME=
PROJECT_SLUG=initial-backend

PORT=5000
POSTGRES_PORT=8694
PGADMIN_PORT=8695

POSTGRES_USER=postgres
POSTGRES_PASSWORD=IB@2026
PGADMIN_EMAIL=ib@localhost.com
PGADMIN_PASSWORD=IB@2026

MAIL=
MAIL_PASS=

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASSWORD=

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

DO_SPACE_ENDPOINT=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_BUCKET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_PROJECT_NAME=

MI_SPACE_ENDPOINT=
MI_SPACE_ACCESS_KEY=
MI_SPACE_SECRET_KEY=
MI_SPACE_BUCKET=
MI_USE_SSL=
MI_PORT=

# --- Mode-specific ---
# See .env.development.example / .env.production.example

# Privileged administrative testing token (Supports comma-separated list for zero-downtime rotation)
SECRET_ADMIN_TOKEN=
ALLOW_PRIVILEGED_ACCESS=false
