model ReturnInvoice {
  id           String @id @default(uuid())
  returnNumber String @unique

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  previousReturnInvoiceId String?
  previousReturnInvoice   ReturnInvoice?  @relation("ReturnInvoiceChain", fields: [previousReturnInvoiceId], references: [id], onDelete: SetNull)
  nextReturnInvoices      ReturnInvoice[] @relation("ReturnInvoiceChain")

  discount       Float         @default(0)
  refundedAmount Float         @default(0)
  status         ReceiptStatus @default(PENDING)
  note           String?
  isDeleted      Boolean       @default(false)

  isDeleteRequested   Boolean   @default(false)
  deleteRequestedById String?
  deleteRequestedBy   User?     @relation("ReturnInvoiceDeleteRequestedBy", fields: [deleteRequestedById], references: [id], onDelete: SetNull)
  deleteRequestedAt   DateTime?
  deleteReason        String?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("ReturnInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("ReturnInvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  items ReturnInvoiceItem[]
  transactions CustomerTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnNumber])
  @@index([receiptId])
  @@index([previousReturnInvoiceId])
  @@index([status])
  @@index([isDeleted])
  @@index([isDeleteRequested])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@map("return_invoices")
}

model ReturnInvoiceItem {
  id              String        @id @default(uuid())
  returnInvoiceId String
  returnInvoice   ReturnInvoice @relation(fields: [returnInvoiceId], references: [id], onDelete: Cascade)

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  receiptItemId String
  receiptItem   ReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName  String
  unit         ProductUnit @default(PIECE)
  sellingPrice Float
  quantity     Float
  discounts    Float[]     @default([])
  totalPrice   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnInvoiceId, receiptItemId])
  @@index([returnInvoiceId])
  @@index([receiptId])
  @@index([receiptItemId])
  @@index([productId])
  @@map("return_invoice_items")
}
