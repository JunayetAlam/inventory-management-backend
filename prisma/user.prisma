model User {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String       @unique
  phoneNumber String?      @unique
  password    String?
  role        UserRoleEnum @default(CASHIER)

  status UserStatus @default(PENDING)

  bio      String?
  location String?

  isAgreeWithTerms Boolean
  profilePhoto     String?

  otp         String?
  otpFor      OTPFor?
  otpExpiry   DateTime?
  otpAttempts Int       @default(0)

  passwordResetToken        String?
  passwordResetTokenExpires DateTime?

  isDeleted                     Boolean   @default(false)
  isEmailVerified               Boolean   @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?

  loginWay LoginWay? @default(EMAIL)

  firebaseUid      String?
  firebaseProvider FirebaseProvider?

  createdById String?
  updatedById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  createdCustomers        Customer[] @relation("CustomerCreatedBy")
  updatedCustomers        Customer[] @relation("CustomerUpdatedBy")
  deleteRequestedCustomers Customer[] @relation("CustomerDeleteRequestedBy")

  createdProducts        Product[] @relation("ProductCreatedBy")
  updatedProducts        Product[] @relation("ProductUpdatedBy")
  deleteRequestedProducts Product[] @relation("ProductDeleteRequestedBy")

  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  updatedInvoices Invoice[] @relation("InvoiceUpdatedBy")
  deleteRequestedInvoices Invoice[] @relation("InvoiceDeleteRequestedBy")

  createdReturnInvoices ReturnInvoice[] @relation("ReturnInvoiceCreatedBy")
  updatedReturnInvoices ReturnInvoice[] @relation("ReturnInvoiceUpdatedBy")
  deleteRequestedReturnInvoices ReturnInvoice[] @relation("ReturnInvoiceDeleteRequestedBy")

  receivedPayments InvoicePayment[] @relation("InvoicePaymentCreatedBy")
  approvedPayments InvoicePayment[] @relation("InvoicePaymentApprovedBy")

  createdShops Shop[] @relation("ShopCreatedBy")
  updatedShops Shop[] @relation("ShopUpdatedBy")

  createdTransactions CustomerTransaction[] @relation("CustomerTransactionCreatedBy")

  activityLogs      ActivityLog[]
  notifications     Notification[]     @relation("UserNotifications")
  notificationReads NotificationRead[]

  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdById])
  @@index([updatedById])
  @@map("users")
}

enum OTPFor {
  USER_VERIFICATION
  FORGOT_PASSWORD
  NOT
}

enum UserRoleEnum {
  SUPERADMIN
  ADMIN
  CASHIER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoginWay {
  EMAIL
  FIREBASE
}

enum FirebaseProvider {
  GOOGLE
  FACEBOOK
}
