model Shop {
  id           String    @id @default(uuid())
  name         String
  proprietor   String?
  logo         String?
  phoneNumbers String[]  @default([])
  emails       String[]  @default([])
  locations    String[]  @default([])

  createdById  String?
  updatedById  String?
  createdBy    User?     @relation("ShopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?     @relation("ShopUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("shops")
}
