model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  subTotal      Float         @default(0)
  discount      Float         @default(0)
  totalAmount   Float         @default(0)
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  status        InvoiceStatus @default(PENDING)
  note          String?
  isDeleted     Boolean       @default(false)

  isDeleteRequested   Boolean   @default(false)
  deleteRequestedById String?
  deleteRequestedBy   User?     @relation("InvoiceDeleteRequestedBy", fields: [deleteRequestedById], references: [id], onDelete: SetNull)
  deleteRequestedAt   DateTime?
  deleteReason        String?

  createdById   String?
  updatedById   String?
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?         @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  items         InvoiceItem[]
  payments      InvoicePayment[]
  returnInvoices ReturnInvoice[]
  returnInvoiceItems ReturnInvoiceItem[]
  transactions  CustomerTransaction[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([isDeleted])
  @@index([isDeleteRequested])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String      @id @default(uuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName  String
  unit         ProductUnit @default(PIECE)
  sellingPrice Float
  buyingPrice  Float?
  quantity     Float
  discounts    Float[]     @default([])
  totalPrice   Float

  returnInvoiceItems ReturnInvoiceItem[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InvoicePayment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount      Float
  note        String?
  status      InvoiceStatus @default(PENDING)

  createdById String?
  createdBy   User?         @relation("InvoicePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?        @relation("InvoicePaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  transactions CustomerTransaction[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([invoiceId])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
  @@map("invoice_payments")
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}
